{
  "name": "gnss-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:core": "node scripts/build-core.mjs",
    "build:engines": "node scripts/copy-engines.mjs",
    "build": "npm run build:core && npm run build:engines && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "licences": "node scripts/check-licences.mjs",
    "test:e2e": "node tests/engine-smoke.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "playwright": "1.56.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
