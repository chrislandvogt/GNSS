# Test data copied from other projects stays byte for byte as published.
crates/formats/tests/data/dynaml/*.xml -text
crates/formats/tests/data/rtklib/*.pos -text
crates/formats/tests/data/sinex/*.SNX -text
crates/formats/tests/data/tdef/*.asc -text

# Generated with LF; a test compares them with the generator byte for byte.
schemas/*.json text eol=lf
# RINEX fixtures are compared byte for byte: never convert their line endings.
crates/rinex-io/tests/data/rinex/** -text

# The IGS antenna files are kept exactly as published; a test checks their SHA-256.
data/antennas/*.gra -text
data/antennas/*.json -text
data/antennas/calibrated.txt -text
